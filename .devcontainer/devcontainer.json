{
  "name": "CPU Design Cursus",
  "build": { "dockerfile": "Dockerfile" },
  "remoteUser": "vscode",
  "containerEnv": { "CHROME": "chromium", "CHROME_FLAGS": "--no-sandbox" },
  // Na het aanmaken: de code uit src/ halen en alle labtests draaien (ongeveer een minuut)
  "postCreateCommand": "python3 extract_labs.py",
  "customizations": {
    "vscode": {
      "extensions": [
        "mshr-h.veriloghdl",
        "surfer-project.surfer",
        "ms-python.python",
        "anthropic.claude-code"
      ]
    }
  }
}
